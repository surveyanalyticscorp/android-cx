<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <supports-screens android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true"
        android:anyDensity="true"/>

    <uses-sdk android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name="com.qpcx.retailapp.AppController"
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:label="@string/app_name"
        android:theme="@style/MyTheme">



        <!-- Single Activity Model-->
        <activity
            android:name="com.qpcx.retailapp.view.activities.ECartHomeActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"/>

        <!-- Splash Activity -->
        <activity
            android:name="com.qpcx.retailapp.view.activities.SplashActivity"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoTitleBar"
            android:exported="true" />

        <activity android:name=".view.activities.ShoppingCartActivity"/>

        <!-- Dynamic app icon aliases — exactly one must be enabled at a time.
             See util.AppIconManager for the switching logic. -->
        <activity-alias
            android:name="com.qpcx.retailapp.AppIconDefault"
            android:enabled="true"
            android:icon="@drawable/app_icon"
            android:label="@string/app_name"
            android:targetActivity="com.qpcx.retailapp.view.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.qpcx.retailapp.AppIconOne"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_one"
            android:label="@string/app_name"
            android:targetActivity="com.qpcx.retailapp.view.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.qpcx.retailapp.AppIconTwo"
            android:enabled="false"
            android:icon="@drawable/ic_launcher_two"
            android:label="@string/app_name"
            android:targetActivity="com.qpcx.retailapp.view.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>


    </application>

</manifest>